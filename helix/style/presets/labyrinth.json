{
  "name": "Labyrinth",
  "blurb": "Right-angle turns in polar space. Ink-thrifty, architectural, the closest thing to a maze.",
  "laser": "excellent",
  "canvas": {
    "width_mm": 600,
    "height_mm": 600,
    "margin_mm": 22,
    "background": "#F4F0E6"
  },
  "layout": {
    "engine": "radial_sunburst",
    "inner_radius_mm": 95,
    "radius_gamma": 0.5,
    "time_scale": true,
    "cell_pad_deg": 0.1
  },
  "cells": {
    "shape": "annular_sector",
    "stroke": "#1C1C1A",
    "stroke_width_mm": 0.32,
    "radial_depth_mm": 9,
    "fill": "none"
  },
  "connectors": {
    "style": "orthogonal",
    "width_mm": 0.4,
    "colour": "#1C1C1A",
    "corner_radius_mm": 2.2
  },
  "type": {
    "family": "'Iowan Old Style','Palatino Linotype',Georgia,serif",
    "size_mm": 2.9,
    "min_size_mm": 2.2,
    "colour": "#1C1C1A"
  },
  "labels": {
    "template": "{given_first} {surname}",
    "by_ring": {
      "0-2": "{given} {surname}\\n{lifespan}",
      "3-4": "{given_first} {surname}\\n{birth_year}"
    }
  },
  "thread": {
    "enabled": true,
    "colour": "#9B3A2E",
    "stroke_width_mm": 1.5,
    "layer": "ENGRAVE_DEEP"
  },
  "ornament": {
    "time_rings": true,
    "time_ring_colour": "#C7BCA6",
    "border": true
  },
  "colour": {
    "mode": "none"
  },
  "id": "labyrinth"
}