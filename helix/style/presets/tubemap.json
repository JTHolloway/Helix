{
  "name": "Tube Map",
  "blurb": "Beck's Underground diagram applied to descent. Coloured routes, tick stations, ringed interchanges.",
  "laser": "good",
  "canvas": {
    "width_mm": 1189,
    "height_mm": 841,
    "margin_mm": 28,
    "background": "#FFFFFF"
  },
  "layout": {
    "engine": "metro_map",
    "time_scale": true,
    "grid_mm": 9
  },
  "connectors": {
    "width_mm": 3.2,
    "line_gap_mm": 4.0,
    "corner_radius_mm": 5.5
  },
  "nodes": {
    "fill": "#FFFFFF",
    "stroke": "#17171A",
    "stroke_width_mm": 0.9
  },
  "type": {
    "family": "'Helvetica Neue',Helvetica,Arial,sans-serif",
    "size_mm": 2.9,
    "min_size_mm": 2.3,
    "weight": 500,
    "colour": "#17171A"
  },
  "labels": {
    "template": "{given_first} {surname}",
    "by_ring": {
      "0-1": "{given_first} {surname}\\n{lifespan}"
    },
    "min_gap_mm": 1.0
  },
  "thread": {
    "enabled": true,
    "colour": "#17171A",
    "stroke_width_mm": 0.8
  },
  "ornament": {
    "time_rings": true,
    "time_ring_colour": "#D7D3CC",
    "border": false
  },
  "colour": {
    "mode": "lineage",
    "palette": [
      "#DC241F",
      "#0019A8",
      "#FFD329",
      "#00782A",
      "#F3A9BB",
      "#A0A5A9",
      "#9B0056",
      "#000000",
      "#003688",
      "#0098D4",
      "#95CDBA",
      "#00A4A7",
      "#EE7C0E",
      "#84B817"
    ]
  },
  "id": "tubemap"
}